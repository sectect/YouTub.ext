{
  "manifest_version": 3,
  "name": "YouTub.ext — YouTube Extension",
  "short_name": "YouTub.ext",
  "version": "1.0.0",
  "description": "Auto skip YouTube intros and outros, dismiss the 'Video paused. Continue watching?' popup, and enjoy nonstop playback.",
  "permissions": ["storage"],
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/logo-16.png",
      "32": "assets/logo-32.png",
      "48": "assets/logo-48.png",
      "128": "assets/logo-128.png"
    },
    "default_title": "YouTub.ext — More control. Better YouTube.",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
